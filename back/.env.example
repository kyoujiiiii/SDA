# LLM provider — NVIDIA NIM (uses the OpenAI-compatible SDK under the hood)
NVAPI_KEY=your_nvapi_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct

# Redis-backed token vault
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=3600

# SQL database (PostgreSQL or SQLite)
# PostgreSQL:  postgresql+psycopg2://user:password@localhost:5432/airlock
# SQLite:      sqlite:///airlock_audit.db
DATABASE_URL=sqlite:///airlock_audit.db

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
