# LLM provider — supports OpenAI and NVIDIA NIM (both use OpenAI-compatible SDK)
# Option 1: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Option 2: NVIDIA NIM
# NVAPI_KEY=nvapi-your-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-8b-instruct

# Redis-backed token vault
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=3600

# SQL database (PostgreSQL or SQLite)
# PostgreSQL:  postgresql+psycopg2://user:password@localhost:5432/airlock
# SQLite:      sqlite:///airlock_audit.db
DATABASE_URL=sqlite:///airlock_audit.db

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
